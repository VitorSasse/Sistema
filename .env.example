DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_fichas"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestao_fichas"
AUTH_SECRET="trocar-por-uma-chave-segura"
AUTH_TRUST_HOST="true"
ADMIN_SEED_EMAIL="admin@seudominio.com"
ADMIN_SEED_PASSWORD="trocar-por-uma-senha-forte"
ADMIN_SEED_NAME="Administrador"
ADMIN_FORCE_RESET="false"

# Performance monitoring
PERFORMANCE_MONITORING_ENABLED="false"
PERFORMANCE_QUERY_LOG_ENABLED="false"
PERFORMANCE_LOG_PAYLOAD_SIZE="true"
PERFORMANCE_SAMPLE_RATE="1"
PERFORMANCE_SLOW_REQUEST_MS="800"
PERFORMANCE_CRITICAL_REQUEST_MS="2000"
PERFORMANCE_SLOW_QUERY_MS="300"
PERFORMANCE_MAX_SLOW_QUERIES_PER_REQUEST="10"
NEXT_PUBLIC_PERFORMANCE_MONITORING_ENABLED="false"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://seu-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

