  propostaOrigem        OrcamentoPropostaComercial?      @relation("ReferenciaPrevistaPropostaOrigem", fields: [propostaOrigemId], references: [id], onDelete: SetNull)
  cenarioOrigem         OrcamentoCenario?                @relation("ReferenciaPrevistaCenarioOrigem", fields: [cenarioOrigemId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([orcamentoOrigemId])
  @@index([propostaOrigemId])
  @@index([cenarioOrigemId])
}

model Material {
