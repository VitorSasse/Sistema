generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusCadastro {
  ATIVO
  INATIVO
}

enum StatusOrdemCompra {
  ABERTA
  AGUARDANDO_APROVACAO
  APROVADA
  COMPRADA
  RECEBIDA
  CANCELADA
}

enum TipoCentroCustoOrdemCompra {
  EQUIPAMENTO
  SETOR
}

enum TipoCatalogoCompra {
  PRODUTO
  SERVICO
  MISTA
}

enum TipoOrcamento {
  COMERCIAL
  OPERACIONAL
}

enum StatusOrcamento {
  RASCUNHO
  EM_ELABORACAO
  EM_REVISAO
  PRONTO_PARA_PROPOSTA
  PROPOSTA_EMITIDA
  EM_NEGOCIACAO
  APROVADO
  REPROVADO
  ARQUIVADO
}

enum TipoItemOrcamento {
  COMERCIAL
  SERVICO_PRINCIPAL
  SERVICO_AUXILIAR
  RECURSO
  MATERIAL
  OUTRO
}

enum CategoriaRecursoOrcamento {
  EQUIPAMENTO
  EQUIPE
  MATERIAL
  TERCEIRO
}

enum NaturezaServico {
  OPERACIONAL
  ORCAMENTARIO_COMPOSTO
  TECNICO_ADMINISTRATIVO
}

enum TipoPremissaOrcamento {
  PREMISSA
  CONDICAO
  EXCLUSAO
  OBSERVACAO
}

enum TipoPlanoConta {
  DESPESA
  RECEITA
}

enum TipoRecurso {
  CAMINHAO
  MAQUINA
  CARRETA
  EQUIPAMENTO_APOIO
  OUTRO
}

enum FuncaoColaborador {
  MOTORISTA
  OPERADOR
  ENCARREGADO
  ADMINISTRATIVO
  OUTRO
}

enum TipoMedicao {
  UNICA
  SEMANAL
  QUINZENAL
  MENSAL
}

enum StatusMedicao {
  CRIADA
  EM_ABERTO
  ENVIADA_AO_CLIENTE
  ENVIADA_PARA_FATURAMENTO
  AGUARDANDO_APROVACAO
  PEDIDO_ANEXADO
  NOTA_FISCAL_ANEXADA
  CONCLUIDA
  EM_ELABORACAO
  ENVIADA
  APROVADA
  CANCELADA
}

enum StatusLancamento {
  VALIDO
  NAO_MEDIDO
  PENDENTE_OBRA
  PENDENTE_PRECO
  DIVERGENTE
  MEDIDO
  CANCELADO
}

enum OrigemLancamento {
  MANUAL
  IMPORTADO
  API
}

enum TipoAlteracao {
  CRIACAO
  EDICAO
  EXCLUSAO_LOGICA
  MUDANCA_STATUS
  FECHAMENTO_MEDICAO
  CANCELAMENTO_MEDICAO
}

enum TipoLogAuditoria {
  LOGIN
  LOGOUT
  CRUD
  EXPORTACAO
  FECHAMENTO_MEDICAO
  CANCELAMENTO_MEDICAO
  ERRO_NEGOCIO
}

enum RoleCodigo {
  ADMIN
  GESTOR
  OPERACIONAL
  FINANCEIRO
  CONSULTA
}

enum TipoCliente {
  CPF
  CNPJ
}

enum TipoAnexo {
  RELATORIO_MEDICAO
  PEDIDO
  NOTA_FISCAL
  OUTRO
}

enum StatusEquipamentoOperacional {
  ATIVO
  EM_OPERACAO
  EM_MANUTENCAO
  PARADO
  INATIVO
}

enum TipoControleEquipamento {
  HORIMETRO
  KM
}

enum UnidadeApontada {
  CARGA
  HORA
  M3
  DIARIA
  SERVICO
}

enum UnidadeFaturada {
  CARGA
  HORA
  M3
  DIARIA
  SERVICO
}

enum OrigemLeituraEquipamento {
  MANUAL
  LANCAMENTO_DIARIO
  MANUTENCAO
  IMPORTADO
  AJUSTE
}

enum CriterioControleManutencao {
  HORIMETRO
  KM
  DIAS
}

enum StatusPlanoManutencao {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum StatusAgendaManutencao {
  PENDENTE
  AGENDADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
  VENCIDA
}

enum StatusAgendaProgramacao {
  PROGRAMADO
  EM_EXECUCAO
  FINALIZADO
  OPERANDO
  DISPONIVEL
  SEM_FRENTE
  MANUTENCAO
  FALTA
  FERIAS
  FERIADO
  CHUVA
}

enum TurnoAgendaProgramacao {
  MANHA
  TARDE
  NOITE
  INTEGRAL
}

enum PrioridadeManutencao {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusAlertaManutencao {
  ATIVO
  LIDO
  RESOLVIDO
  CANCELADO
}

enum TipoAlertaManutencao {
  HORIMETRO_VENCIDO
  KM_VENCIDO
  DATA_VENCIDA
  PROXIMO_VENCIMENTO
  SEM_ATUALIZACAO
  EQUIPAMENTO_PARADO
  LEITURA_INCONSISTENTE
}

model Usuario {
  id                            String                @id @default(uuid())
  nome                          String
  email                         String                @unique
  senhaHash                     String
  status                        StatusCadastro        @default(ATIVO)
  ultimoLoginEm                 DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  roles                         UsuarioRole[]
  fichasCriadas                 Ficha[]               @relation("FichaCriadaPor")
  lancCriados                   LancamentoDiario[]    @relation("LancamentoCriadoPor")
  lancAtualizados               LancamentoDiario[]    @relation("LancamentoAtualizadoPor")
  medicoesFechadas              Medicao[]             @relation("MedicaoFechadaPor")
  historicos                    HistoricoAlteracao[]
  logsAuditoria                 LogAuditoria[]
  leiturasEquipamento           LeituraEquipamento[]
  planosManutencaoResponsaveis  PlanoManutencao[]     @relation("PlanoManutencaoResponsavel")
  agendasManutencaoResponsaveis AgendaManutencao[]    @relation("AgendaManutencaoResponsavel")
  manutencoesRegistradas        ManutencaoExecutada[] @relation("ManutencaoRegistradaPor")
  manutencoesExecutadas         ManutencaoExecutada[] @relation("ManutencaoExecutadaPor")
  ordensCompraCriadas           OrdemCompra[]         @relation("OrdemCompraCriadaPor")
  orcamentosCriados             Orcamento[]           @relation("OrcamentoCriadoPor")
  orcamentosResponsavel         Orcamento[]           @relation("OrcamentoResponsavel")
}

model Role {
  id        String        @id @default(uuid())
  codigo    RoleCodigo    @unique
  nome      String
  createdAt DateTime      @default(now())
  usuarios  UsuarioRole[]
}

model UsuarioRole {
  usuarioId String
  roleId    String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([usuarioId, roleId])
}

model Cliente {
  id                String             @id @default(uuid())
  codigo            String             @unique
  tipoCliente       TipoCliente        @default(CNPJ)
  nome              String
  nomeFantasia      String?
  cpf               String?            @unique
  cnpj              String?            @unique
  inscricaoEstadual String?
  contatoNome       String?
  telefone          String?
  email             String?
  enderecoLinha1    String?
  enderecoNumero    String?
  enderecoLinha2    String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  observacao        String?
  status            StatusCadastro     @default(ATIVO)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  obras             Obra[]
  fichas            Ficha[]
  lancamentos       LancamentoDiario[]
  precos            PrecoClienteObra[]
  medicoes          Medicao[]
  orcamentos        Orcamento[]

  @@index([nome])
  @@index([status, nome])
}

model Obra {
  id                     String              @id @default(uuid())
  codigo                 String              @unique
  clienteId              String
  nome                   String
  contratoNumero         String?
  localidade             String?
  cidade                 String?
  uf                     String?
  dataInicio             DateTime?
  dataFim                DateTime?
  observacao             String?
  status                 StatusCadastro      @default(ATIVO)
  liberadaParaLancamento Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  cliente                Cliente             @relation(fields: [clienteId], references: [id])
  fichas                 Ficha[]
  lancamentos            LancamentoDiario[]
  precos                 PrecoClienteObra[]
  medicoes               Medicao[]
  programacoes           AgendaProgramacao[]
  orcamentos             Orcamento[]

  @@index([nome])
  @@index([clienteId, status])
}

model Fornecedor {
  id                String         @id @default(uuid())
  codigo            String         @unique
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String?        @unique
  inscricaoEstadual String?
  telefone          String?
  email             String?
  enderecoLinha1    String?
  enderecoNumero    String?
  enderecoLinha2    String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  observacao        String?
  status            StatusCadastro @default(ATIVO)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  ordensCompra      OrdemCompra[]

  @@index([razaoSocial])
  @@index([nomeFantasia])
  @@index([status, razaoSocial])
}

model CentroCustoCompra {
  id           String         @id @default(uuid())
  codigo       String         @unique
  nome         String
  descricao    String?
  status       StatusCadastro @default(ATIVO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ordensCompra OrdemCompra[]

  @@index([nome])
  @@index([status, nome])
}

model CatalogoCompra {
  id               String             @id @default(uuid())
  codigo           String             @unique
  tipo             TipoCatalogoCompra
  descricao        String
  unidadePadrao    String
  valorPadrao      Decimal            @default(0) @db.Decimal(12, 2)
  observacao       String?
  status           StatusCadastro     @default(ATIVO)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  itensOrdemCompra OrdemCompraItem[]

  @@index([tipo, status, descricao])
  @@index([descricao])
}

model PlanoConta {
  id            String         @id @default(uuid())
  classificacao String         @unique
  nome          String
  tipo          TipoPlanoConta
  categoria     String?
  descricao     String?
  status        StatusCadastro @default(ATIVO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ordensCompra  OrdemCompra[]

  @@index([tipo, status, nome])
  @@index([status, nome])
  @@index([classificacao])
}

model Equipamento {
  id                           String                       @id @default(uuid())
  tipoRecurso                  TipoRecurso
  tipoControle                 TipoControleEquipamento      @default(HORIMETRO)
  descricao                    String
  placaOuTag                   String                       @unique
  classeOperacional            String?
  complementar                 Boolean                      @default(false)
  fabricante                   String?
  modelo                       String?
  marcaModelo                  String?
  anoFabricacao                Int?
  dataEntrada                  DateTime?
  capacidadeM3                 Decimal?                     @db.Decimal(10, 2)
  unidadeCapacidade            String?
  apelido                      String?
  observacao                   String?
  status                       StatusCadastro               @default(ATIVO)
  statusOperacional            StatusEquipamentoOperacional @default(ATIVO)
  horimetroAtual               Decimal?                     @db.Decimal(12, 2)
  kmAtual                      Decimal?                     @db.Decimal(12, 1)
  periodicidadeManutencaoHoras Int?
  periodicidadeManutencaoKm    Int?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  lancamentos                  LancamentoDiario[]
  precos                       PrecoClienteObra[]
  leituras                     LeituraEquipamento[]
  planosManutencao             PlanoManutencao[]
  agendasManutencao            AgendaManutencao[]
  programacoes                 AgendaProgramacao[]
  manutencoesExecutadas        ManutencaoExecutada[]
  alertasManutencao            AlertaManutencao[]
  ordensCompraCentroCusto      OrdemCompra[]                @relation("OrdemCompraCentroCustoEquipamento")
  orcamentoItens               OrcamentoItem[]

  @@index([descricao])
  @@index([tipoRecurso, status])
  @@index([classeOperacional])
  @@index([statusOperacional, status])
  @@index([complementar, status, tipoRecurso])
}

model OrdemCompra {
  id                       String                     @id @default(uuid())
  numeroOrdem              String                     @unique
  dataEmissao              DateTime                   @default(now())
  status                   StatusOrdemCompra          @default(ABERTA)
  tipoCompra               TipoCatalogoCompra         @default(PRODUTO)
  fornecedorId             String
  centroCustoId            String?
  planoContaId             String?
  centroCustoTipo          TipoCentroCustoOrdemCompra @default(SETOR)
  centroCustoNome          String
  centroCustoEquipamentoId String?
  formaPagamento           String?
  numeroParcelas           Int                        @default(1)
  primeiroVencimento       DateTime?
  numeroNotaFiscal         String?
  solicitanteNome          String?
  observacaoFinanceira     String?
  observacao               String?
  motivoExclusao           String?
  excluidaEm               DateTime?
  excluidaPorNome          String?
  valorTotal               Decimal                    @db.Decimal(14, 2)
  criadoPorId              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  fornecedor               Fornecedor                 @relation(fields: [fornecedorId], references: [id])
  centroCusto              CentroCustoCompra?         @relation(fields: [centroCustoId], references: [id])
  planoConta               PlanoConta?                @relation(fields: [planoContaId], references: [id])
  centroCustoEquipamento   Equipamento?               @relation("OrdemCompraCentroCustoEquipamento", fields: [centroCustoEquipamentoId], references: [id])
  criadoPor                Usuario                    @relation("OrdemCompraCriadaPor", fields: [criadoPorId], references: [id])
  itens                    OrdemCompraItem[]
  parcelas                 OrdemCompraParcela[]
  anexos                   Anexo[]

  @@index([status, dataEmissao])
  @@index([fornecedorId, dataEmissao])
  @@index([centroCustoId, dataEmissao])
  @@index([planoContaId, dataEmissao])
  @@index([numeroNotaFiscal])
  @@index([centroCustoNome, dataEmissao])
}

model OrdemCompraItem {
  id               String             @id @default(uuid())
  ordemCompraId    String
  catalogoCompraId String?
  tipoItem         TipoCatalogoCompra @default(PRODUTO)
  item             String
  codigo           String?
  descricao        String
  unidade          String
  quantidade       Decimal            @db.Decimal(12, 2)
  valorUnitario    Decimal            @db.Decimal(12, 2)
  subtotal         Decimal            @db.Decimal(14, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ordemCompra      OrdemCompra        @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)
  catalogoCompra   CatalogoCompra?    @relation(fields: [catalogoCompraId], references: [id])

  @@index([ordemCompraId])
  @@index([catalogoCompraId])
}

model OrdemCompraParcela {
  id             String      @id @default(uuid())
  ordemCompraId  String
  numeroParcela  Int
  dataVencimento DateTime
  valorParcela   Decimal     @db.Decimal(14, 2)
  observacao     String?
  createdAt      DateTime    @default(now())
  ordemCompra    OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@unique([ordemCompraId, numeroParcela])
  @@index([dataVencimento])
}

model Orcamento {
  id                String                  @id @default(uuid())
  codigo            String                  @unique
  tipo              TipoOrcamento           @default(COMERCIAL)
  status            StatusOrcamento         @default(RASCUNHO)
  clienteId         String
  obraId            String?
  responsavelId     String?
  dataOrcamento     DateTime                @default(now())
  validadeAte       DateTime?
  titulo            String?
  objeto            String?
  observacaoInterna String?
  observacaoCliente String?
  valorSubtotal     Decimal                 @default(0) @db.Decimal(14, 2)
  valorDesconto     Decimal                 @default(0) @db.Decimal(14, 2)
  valorAcrescimo    Decimal                 @default(0) @db.Decimal(14, 2)
  valorTotal        Decimal                 @default(0) @db.Decimal(14, 2)
  criadoPorId       String
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  cliente           Cliente                 @relation(fields: [clienteId], references: [id])
  obra              Obra?                   @relation(fields: [obraId], references: [id])
  responsavel       Usuario?                @relation("OrcamentoResponsavel", fields: [responsavelId], references: [id])
  criadoPor         Usuario                 @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id])
  formacaoPreco     OrcamentoFormacaoPreco?
  frentes           OrcamentoFrente[]
  itens             OrcamentoItem[]
  premissas         OrcamentoPremissa[]

  @@index([clienteId, obraId, dataOrcamento])
  @@index([status, dataOrcamento])
  @@index([tipo, status])
  @@index([deletedAt, status])
  @@index([responsavelId, dataOrcamento])
}

model OrcamentoFormacaoPreco {
  id                 String    @id @default(uuid())
  orcamentoId        String    @unique
  custoDireto        Decimal   @default(0) @db.Decimal(14, 2)
  custoIndireto      Decimal   @default(0) @db.Decimal(14, 2)
  impostosPercentual Decimal   @default(0) @db.Decimal(7, 4)
  impostosValor      Decimal   @default(0) @db.Decimal(14, 2)
  margemPercentual   Decimal   @default(0) @db.Decimal(7, 4)
  margemValor        Decimal   @default(0) @db.Decimal(14, 2)
  precoSugerido      Decimal   @default(0) @db.Decimal(14, 2)
  precoFinal         Decimal   @default(0) @db.Decimal(14, 2)
  observacao         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  orcamento          Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

model OrcamentoFrente {
  id                 String          @id @default(uuid())
  orcamentoId        String
  ordem              Int             @default(1)
  nome               String
  descricao          String?
  metodoExecutivo    String?
  unidadeProducao    String?
  quantidadePrevista Decimal?        @db.Decimal(12, 2)
  produtividadeDia   Decimal?        @db.Decimal(12, 2)
  prazoEstimadoDias  Decimal?        @db.Decimal(12, 2)
  observacao         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orcamento          Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itens              OrcamentoItem[]

  @@index([orcamentoId, ordem])
}

model OrcamentoItem {
  id                  String                     @id @default(uuid())
  orcamentoId         String
  frenteId            String?
  tipoItem            TipoItemOrcamento          @default(COMERCIAL)
  servicoId           String?
  materialId          String?
  equipamentoId       String?
  categoriaRecurso    CategoriaRecursoOrcamento?
  classeOperacional   String?
  recursoReferenciaId String?
  recursoNome         String?
  ordem               Int                        @default(1)
  codigo              String?
  descricao           String
  unidade             String
  quantidade          Decimal                    @default(0) @db.Decimal(12, 2)
  produtividade       Decimal?                   @db.Decimal(12, 2)
  custoUnitario       Decimal                    @default(0) @db.Decimal(12, 2)
  valorUnitario       Decimal                    @default(0) @db.Decimal(12, 2)
  valorTotal          Decimal                    @default(0) @db.Decimal(14, 2)
  observacao          String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  orcamento           Orcamento                  @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  frente              OrcamentoFrente?           @relation(fields: [frenteId], references: [id], onDelete: Cascade)
  servico             Servico?                   @relation(fields: [servicoId], references: [id])
  material            Material?                  @relation(fields: [materialId], references: [id])
  equipamento         Equipamento?               @relation(fields: [equipamentoId], references: [id])

  @@index([orcamentoId, ordem])
  @@index([frenteId, ordem])
  @@index([servicoId])
  @@index([materialId])
  @@index([equipamentoId])
  @@index([categoriaRecurso])
  @@index([classeOperacional])
}

model OrcamentoPremissa {
  id          String                @id @default(uuid())
  orcamentoId String
  tipo        TipoPremissaOrcamento @default(PREMISSA)
  ordem       Int                   @default(1)
  titulo      String?
  descricao   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  orcamento   Orcamento             @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId, tipo, ordem])
}

model Material {
  id             String             @id @default(uuid())
  codigoMaterial String             @unique
  descricao      String
  categoria      String?
  unidadePadrao  String
  densidade      Decimal?           @db.Decimal(10, 3)
  origemMaterial String?
  observacao     String?
  status         StatusCadastro     @default(ATIVO)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lancamentos    LancamentoDiario[]
  precos         PrecoClienteObra[]
  orcamentoItens OrcamentoItem[]

  @@index([descricao])
}

model Servico {
  id                 String             @id @default(uuid())
  codigo             String             @unique
  tipoServico        String
  categoria          String?
  natureza           NaturezaServico    @default(OPERACIONAL)
  usarEmOrcamentos   Boolean            @default(true)
  usarEmFichas       Boolean            @default(true)
  usarEmMedicoes     Boolean            @default(true)
  usarEmFaturamento  Boolean            @default(true)
  servicoTecnico     Boolean            @default(false)
  faturamentoFechado Boolean            @default(false)
  valorFechadoPadrao Decimal?           @db.Decimal(12, 2)
  formaMedicao       String
  unidadeApontamento String?
  unidadeFaturamento String
  exigeMaterial      Boolean            @default(false)
  ativoParaMedicao   Boolean            @default(true)
  observacao         String?
  status             StatusCadastro     @default(ATIVO)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lancamentos        LancamentoDiario[]
  precos             PrecoClienteObra[]
  orcamentoItens     OrcamentoItem[]

  @@index([codigo])
  @@index([status, tipoServico])
  @@index([natureza, status])
}

model Colaborador {
  id           String             @id @default(uuid())
  codigo       String             @unique
  nome         String
  apelido      String?
  funcao       FuncaoColaborador
  documento    String?
  telefone     String?
  dataAdmissao DateTime?
  dataSaida    DateTime?
  observacao   String?
  status       StatusCadastro     @default(ATIVO)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lancamentos  LancamentoDiario[]

  @@index([nome])
  @@index([funcao, status])
}

model PrecoClienteObra {
  id                   String             @id @default(uuid())
  clienteId            String
  obraId               String
  servicoId            String
  materialId           String?
  equipamentoId        String?
  unidadeFaturamento   String
  valorUnitario        Decimal            @db.Decimal(12, 2)
  vigenciaInicial      DateTime
  vigenciaFinal        DateTime?
  status               StatusCadastro     @default(ATIVO)
  observacao           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  cliente              Cliente            @relation(fields: [clienteId], references: [id])
  obra                 Obra               @relation(fields: [obraId], references: [id])
  servico              Servico            @relation(fields: [servicoId], references: [id])
  material             Material?          @relation(fields: [materialId], references: [id])
  equipamento          Equipamento?       @relation(fields: [equipamentoId], references: [id])
  lancamentosAplicados LancamentoDiario[]

  @@index([clienteId, obraId, servicoId, vigenciaInicial])
  @@index([materialId])
  @@index([equipamentoId])
}

model Ficha {
  id          String             @id @default(uuid())
  numero      String
  data        DateTime
  clienteId   String
  obraId      String?
  observacao  String?
  origem      OrigemLancamento   @default(MANUAL)
  criadoPorId String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cliente     Cliente            @relation(fields: [clienteId], references: [id])
  obra        Obra?              @relation(fields: [obraId], references: [id])
  criadoPor   Usuario            @relation("FichaCriadaPor", fields: [criadoPorId], references: [id])
  lancamentos LancamentoDiario[]
  romaneios   FichaRomaneio[]
  anexos      Anexo[]

  @@unique([numero, data, clienteId, obraId])
  @@index([clienteId, obraId, data])
}

model FichaRomaneio {
  id        String    @id @default(uuid())
  fichaId   String
  numero    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  ficha     Ficha     @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@unique([fichaId, numero])
  @@index([fichaId, deletedAt, numero])
}

model LancamentoDiario {
  id                 String               @id @default(uuid())
  fichaId            String
  data               DateTime
  clienteId          String
  obraId             String?
  servicoId          String
  materialId         String?
  equipamentoId      String
  colaboradorId      String
  quantidadeApontada Decimal              @db.Decimal(12, 2)
  unidadeApontada    UnidadeApontada      @default(HORA)
  quantidadeFaturada Decimal              @default(0) @db.Decimal(12, 2)
  unidadeFaturada    UnidadeFaturada      @default(HORA)
  horimetroInformado Decimal?             @db.Decimal(12, 2)
  kmInformado        Decimal?             @db.Decimal(12, 1)
  observacao         String?
  statusValidacao    StatusLancamento     @default(VALIDO)
  origem             OrigemLancamento     @default(MANUAL)
  precoAplicadoId    String?
  criadoPorId        String
  atualizadoPorId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  ficha              Ficha                @relation(fields: [fichaId], references: [id])
  cliente            Cliente              @relation(fields: [clienteId], references: [id])
  obra               Obra?                @relation(fields: [obraId], references: [id])
  servico            Servico              @relation(fields: [servicoId], references: [id])
  material           Material?            @relation(fields: [materialId], references: [id])
  equipamento        Equipamento          @relation(fields: [equipamentoId], references: [id])
  colaborador        Colaborador          @relation(fields: [colaboradorId], references: [id])
  precoAplicado      PrecoClienteObra?    @relation(fields: [precoAplicadoId], references: [id])
  criadoPor          Usuario              @relation("LancamentoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoPor      Usuario?             @relation("LancamentoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  medicaoItens       MedicaoItem[]
  leituraEquipamento LeituraEquipamento?
  romaneios          LancamentoRomaneio[]

  @@index([data, clienteId, obraId])
  @@index([fichaId])
  @@index([equipamentoId, data])
  @@index([colaboradorId, data])
  @@index([statusValidacao, data])
  @@index([clienteId, obraId, deletedAt, statusValidacao, data])
}

model LancamentoRomaneio {
  id           String           @id @default(uuid())
  lancamentoId String
  numero       String
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  lancamento   LancamentoDiario @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  @@unique([lancamentoId, numero])
  @@index([lancamentoId, deletedAt, numero])
}

model LeituraEquipamento {
  id                 String                   @id @default(uuid())
  equipamentoId      String
  dataLeitura        DateTime
  horimetroValor     Decimal?                 @db.Decimal(12, 2)
  kmValor            Decimal?                 @db.Decimal(12, 1)
  origem             OrigemLeituraEquipamento
  usuarioId          String
  lancamentoDiarioId String?                  @unique
  observacao         String?
  createdAt          DateTime                 @default(now())
  equipamento        Equipamento              @relation(fields: [equipamentoId], references: [id])
  usuario            Usuario                  @relation(fields: [usuarioId], references: [id])
  lancamentoDiario   LancamentoDiario?        @relation(fields: [lancamentoDiarioId], references: [id])

  @@index([equipamentoId, dataLeitura])
  @@index([origem, dataLeitura])
  @@index([usuarioId, dataLeitura])
}

model PlanoManutencao {
  id                     String                     @id @default(uuid())
  equipamentoId          String
  titulo                 String
  tipoManutencao         String
  criterioControle       CriterioControleManutencao
  periodicidadeValor     Int
  toleranciaValor        Int                        @default(0)
  ultimaExecucaoEm       DateTime?
  ultimaLeituraHorimetro Decimal?                   @db.Decimal(12, 2)
  ultimaLeituraKm        Decimal?                   @db.Decimal(12, 1)
  proximaExecucaoEm      DateTime?
  proximoHorimetro       Decimal?                   @db.Decimal(12, 2)
  proximoKm              Decimal?                   @db.Decimal(12, 1)
  status                 StatusPlanoManutencao      @default(ATIVO)
  responsavelId          String?
  observacao             String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  equipamento            Equipamento                @relation(fields: [equipamentoId], references: [id])
  responsavel            Usuario?                   @relation("PlanoManutencaoResponsavel", fields: [responsavelId], references: [id])
  agendas                AgendaManutencao[]
  manutencoesExecutadas  ManutencaoExecutada[]
  alertas                AlertaManutencao[]

  @@index([equipamentoId, status])
  @@index([criterioControle, status])
  @@index([proximaExecucaoEm])
}

model AgendaManutencao {
  id                       String                     @id @default(uuid())
  equipamentoId            String
  planoId                  String?
  tipoManutencao           String
  criterioControle         CriterioControleManutencao
  dataReferencia           DateTime?
  dataPrevista             DateTime?
  dataLimite               DateTime?
  leituraPrevistaHorimetro Decimal?                   @db.Decimal(12, 2)
  leituraPrevistaKm        Decimal?                   @db.Decimal(12, 1)
  prioridade               PrioridadeManutencao       @default(MEDIA)
  status                   StatusAgendaManutencao     @default(PENDENTE)
  responsavelId            String?
  observacao               String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  equipamento              Equipamento                @relation(fields: [equipamentoId], references: [id])
  plano                    PlanoManutencao?           @relation(fields: [planoId], references: [id])
  responsavel              Usuario?                   @relation("AgendaManutencaoResponsavel", fields: [responsavelId], references: [id])
  manutencoesExecutadas    ManutencaoExecutada[]
  alertas                  AlertaManutencao[]

  @@index([equipamentoId, status])
  @@index([dataPrevista, status])
  @@index([planoId])
}

model AgendaProgramacao {
  id            String                  @id @default(uuid())
  equipamentoId String
  obraId        String?
  local         String?
  dataInicio    DateTime
  dataFim       DateTime
  turno         TurnoAgendaProgramacao?
  status        StatusAgendaProgramacao @default(PROGRAMADO)
  observacoes   String?
  deletedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  equipamento   Equipamento             @relation(fields: [equipamentoId], references: [id])
  obra          Obra?                   @relation(fields: [obraId], references: [id])

  @@index([equipamentoId, dataInicio, dataFim])
  @@index([equipamentoId, deletedAt, dataInicio, dataFim])
  @@index([obraId, dataInicio])
  @@index([status, dataInicio])
  @@index([deletedAt])
}

model ManutencaoExecutada {
  id                String            @id @default(uuid())
  equipamentoId     String
  planoId           String?
  agendaId          String?
  dataExecucao      DateTime
  tipoManutencao    String
  descricaoServico  String
  horimetroMomento  Decimal?          @db.Decimal(12, 2)
  kmMomento         Decimal?          @db.Decimal(12, 1)
  pecasTrocadas     Json?
  fornecedorOficina String?
  custo             Decimal?          @db.Decimal(14, 2)
  observacao        String?
  executadoPorId    String?
  registradoPorId   String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  equipamento       Equipamento       @relation(fields: [equipamentoId], references: [id])
  plano             PlanoManutencao?  @relation(fields: [planoId], references: [id])
  agenda            AgendaManutencao? @relation(fields: [agendaId], references: [id])
  executadoPor      Usuario?          @relation("ManutencaoExecutadaPor", fields: [executadoPorId], references: [id])
  registradoPor     Usuario           @relation("ManutencaoRegistradaPor", fields: [registradoPorId], references: [id])
  anexos            AnexoManutencao[]

  @@index([equipamentoId, dataExecucao])
  @@index([planoId, dataExecucao])
  @@index([agendaId])
}

model AlertaManutencao {
  id                         String                 @id @default(uuid())
  equipamentoId              String
  planoId                    String?
  agendaId                   String?
  tipoAlerta                 TipoAlertaManutencao
  titulo                     String
  descricao                  String
  prioridade                 PrioridadeManutencao   @default(MEDIA)
  status                     StatusAlertaManutencao @default(ATIVO)
  dataReferencia             DateTime?
  leituraReferenciaHorimetro Decimal?               @db.Decimal(12, 2)
  leituraReferenciaKm        Decimal?               @db.Decimal(12, 1)
  disparadoEm                DateTime               @default(now())
  resolvidoEm                DateTime?
  origemAutomatica           Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  equipamento                Equipamento            @relation(fields: [equipamentoId], references: [id])
  plano                      PlanoManutencao?       @relation(fields: [planoId], references: [id])
  agenda                     AgendaManutencao?      @relation(fields: [agendaId], references: [id])

  @@index([equipamentoId, status])
  @@index([tipoAlerta, status])
  @@index([disparadoEm])
}

model AnexoManutencao {
  id           String              @id @default(uuid())
  manutencaoId String
  nomeArquivo  String
  mimeType     String
  urlArquivo   String
  tamanhoBytes Int
  createdAt    DateTime            @default(now())
  manutencao   ManutencaoExecutada @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)

  @@index([manutencaoId])
}

model Medicao {
  id                        String        @id @default(uuid())
  codigoMedicao             String        @unique
  tipoMedicao               TipoMedicao   @default(QUINZENAL)
  clienteId                 String
  obraId                    String?
  periodoInicial            DateTime
  periodoFinal              DateTime
  status                    StatusMedicao @default(CRIADA)
  valorTotal                Decimal       @default(0) @db.Decimal(14, 2)
  descontoValor             Decimal       @default(0) @db.Decimal(14, 2)
  permutaPercentual         Decimal       @default(0) @db.Decimal(5, 2)
  observacao                String?
  observacaoInterna         String?
  justificativaCancelamento String?
  numeroPedido              String?
  numeroNotaFiscal          String?
  fechadoPorId              String?
  fechadoEm                 DateTime?
  canceladaEm               DateTime?
  enviadaAoClienteEm        DateTime?
  enviadaParaFaturamentoEm  DateTime?
  aprovadaEm                DateTime?
  pedidoAnexadoEm           DateTime?
  notaFiscalAnexadaEm       DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  cliente                   Cliente       @relation(fields: [clienteId], references: [id])
  obra                      Obra?         @relation(fields: [obraId], references: [id])
  fechadoPor                Usuario?      @relation("MedicaoFechadaPor", fields: [fechadoPorId], references: [id])
  itens                     MedicaoItem[]
  anexos                    Anexo[]

  @@index([clienteId, obraId, periodoInicial, periodoFinal])
  @@index([status])
  @@index([deletedAt, status])
  @@index([numeroPedido])
  @@index([numeroNotaFiscal])
}

model MedicaoItem {
  id                 String           @id @default(uuid())
  medicaoId          String
  lancamentoId       String
  data               DateTime
  ficha              String
  placaOuTag         String
  tipoServico        String
  material           String?
  unidadeFaturada    UnidadeFaturada  @default(HORA)
  quantidadeFaturada Decimal          @default(0) @db.Decimal(12, 2)
  m3SeAplicavel      Decimal?         @db.Decimal(12, 2)
  valorUnitario      Decimal          @default(0) @db.Decimal(12, 2)
  valorTotalItem     Decimal          @default(0) @db.Decimal(14, 2)
  origem             OrigemLancamento
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  medicao            Medicao          @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  lancamento         LancamentoDiario @relation(fields: [lancamentoId], references: [id])

  @@index([medicaoId, data])
  @@index([medicaoId, deletedAt, data])
  @@index([lancamentoId])
  @@index([deletedAt])
}

model HistoricoAlteracao {
  id            String        @id @default(uuid())
  entidade      String
  entidadeId    String
  campo         String
  valorAnterior String?
  valorNovo     String?
  motivo        String?
  tipoAlteracao TipoAlteracao
  usuarioId     String
  createdAt     DateTime      @default(now())
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId, createdAt])
}

model Anexo {
  id            String       @id @default(uuid())
  fichaId       String?
  medicaoId     String?
  ordemCompraId String?
  tipo          TipoAnexo    @default(OUTRO)
  nomeArquivo   String
  mimeType      String
  urlArquivo    String
  tamanhoBytes  Int
  createdAt     DateTime     @default(now())
  ficha         Ficha?       @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  medicao       Medicao?     @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  ordemCompra   OrdemCompra? @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([medicaoId])
  @@index([ordemCompraId])
}

model LogAuditoria {
  id         String           @id @default(uuid())
  tipo       TipoLogAuditoria
  entidade   String?
  entidadeId String?
  acao       String
  detalhes   Json?
  ip         String?
  userAgent  String?
  usuarioId  String?
  createdAt  DateTime         @default(now())
  usuario    Usuario?         @relation(fields: [usuarioId], references: [id])

  @@index([tipo, createdAt])
  @@index([entidade, entidadeId])
}
