model Usuario {
  id                            String                @id @default(uuid())
  empresaId                     String
  nome                          String
  email                         String                @unique
  senhaHash                     String
  telefone                      String?
  cargo                         String?
    fotoPerfilUrl                 String?               @db.Text
    status                        StatusCadastro        @default(ATIVO)
    roleEmpresa                   RoleUsuarioEmpresa    @default(ADMIN_EMPRESA)
    modoSomenteLeitura            Boolean               @default(false)
    permissoesAcesso              Json                  @default("{}")
    ultimoLoginEm                 DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  empresa                       Empresa               @relation(fields: [empresaId], references: [id])
  empresasAcesso                UsuarioEmpresa[]
  roles                         UsuarioRole[]
  fichasCriadas                 Ficha[]               @relation("FichaCriadaPor")
  lancCriados                   LancamentoDiario[]    @relation("LancamentoCriadoPor")
  lancAtualizados               LancamentoDiario[]    @relation("LancamentoAtualizadoPor")
  medicoesFechadas              Medicao[]             @relation("MedicaoFechadaPor")
  historicos                    HistoricoAlteracao[]
  logsAuditoria                 LogAuditoria[]
  leiturasEquipamento           LeituraEquipamento[]
  planosManutencaoResponsaveis  PlanoManutencao[]     @relation("PlanoManutencaoResponsavel")
  agendasManutencaoResponsaveis AgendaManutencao[]    @relation("AgendaManutencaoResponsavel")
  manutencoesRegistradas        ManutencaoExecutada[] @relation("ManutencaoRegistradaPor")
  manutencoesExecutadas         ManutencaoExecutada[] @relation("ManutencaoExecutadaPor")
  ordensCompraCriadas           OrdemCompra[]         @relation("OrdemCompraCriadaPor")
  orcamentosCriados             Orcamento[]           @relation("OrcamentoCriadoPor")
  orcamentosResponsavel         Orcamento[]           @relation("OrcamentoResponsavel")
  propostasEmitidas             OrcamentoPropostaComercial[] @relation("PropostaEmitidaPor")

    @@index([empresaId])
    @@index([roleEmpresa])
    @@index([modoSomenteLeitura])
  }

model Role {
  id        String        @id @default(uuid())
  codigo    RoleCodigo    @unique
  nome      String
  createdAt DateTime      @default(now())
  usuarios  UsuarioRole[]
}

model UsuarioRole {
  usuarioId String
  roleId    String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([usuarioId, roleId])
}

model Empresa {
  id                           String                       @id @default(uuid())
  nome                         String
  nomeFantasia                 String?
  razaoSocial                  String?
  cnpj                         String?                      @unique
  email                        String?
  telefone                     String?
  endereco                     String?
  cidade                       String?
  estado                       String?
  cep                          String?
  logoUrl                      String?
  corPrimaria                  String?
  status                       StatusCadastro               @default(ATIVO)
  plano                        String?                      @default("PADRAO")
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  deletedAt                    DateTime?
  usuarios                     Usuario[]
  usuariosAcesso               UsuarioEmpresa[]
  clientes                     Cliente[]
  obras                        Obra[]
  fornecedores                 Fornecedor[]
  centrosCustoCompra           CentroCustoCompra[]
  catalogosCompra              CatalogoCompra[]
  planosConta                  PlanoConta[]
  equipamentos                 Equipamento[]
  ordensCompra                 OrdemCompra[]
  ordensCompraItens            OrdemCompraItem[]
  ordensCompraParcelas         OrdemCompraParcela[]
  materiais                    Material[]
  servicos                     Servico[]
  colaboradores                Colaborador[]
  precosClienteObra            PrecoClienteObra[]
  fichas                       Ficha[]
  fichasRomaneio               FichaRomaneio[]
  lancamentosDiarios           LancamentoDiario[]
  lancamentosRomaneio          LancamentoRomaneio[]
  leiturasEquipamento          LeituraEquipamento[]
  planosManutencao             PlanoManutencao[]
  agendasManutencao            AgendaManutencao[]
  agendasProgramacao           AgendaProgramacao[]
  manutencoesExecutadas        ManutencaoExecutada[]
  alertasManutencao            AlertaManutencao[]
  anexosManutencao             AnexoManutencao[]
  itensManutencaoExecutada     ItemManutencaoExecutada[]
  medicoes                     Medicao[]
  medicaoItens                 MedicaoItem[]
  historicosAlteracao          HistoricoAlteracao[]
  anexos                       Anexo[]
  logsAuditoria                LogAuditoria[]
  orcamentos                   Orcamento[]
  orcamentosFormacaoPreco      OrcamentoFormacaoPreco[]
  orcamentosCenarios           OrcamentoCenario[]
  orcamentosFrentes            OrcamentoFrente[]
  orcamentosItens              OrcamentoItem[]
  orcamentosPremissas          OrcamentoPremissa[]
  orcamentosPropostas          OrcamentoPropostaComercial[]
  orcamentosPropostasOpcionais OrcamentoPropostaOpcional[]
  documentosCabecalhos         DocumentoCabecalhoConfig[]
  execucoes                    Execucao[]
  frentesExecutadas            FrenteExecutada[]
  recursosRealizados           RecursoRealizado[]
  resultadosExecucao           ResultadoExecucao[]
  boletinsDiariosProducao      BoletimDiarioProducao[]
  recursosBoletimDiario        RecursoBoletimDiario[]
  encargosEconomicosExecucao   EncargoEconomicoExecucao[]
  referenciasPrevistasExecucao ExecucaoReferenciaPrevista[]

  @@index([status, nome])
  @@index([deletedAt])
}

model UsuarioEmpresa {
  id                  String             @id @default(uuid())
  usuarioId           String
  empresaId           String
  roleEmpresa         RoleUsuarioEmpresa @default(OPERADOR)
  modoSomenteLeitura  Boolean            @default(false)
  permissoesAcesso    Json               @default("{}")
  status              StatusCadastro     @default(ATIVO)
  padrao              Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  usuario             Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa             Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId, status])
  @@index([usuarioId, status])
  @@index([usuarioId, padrao])
}

model DocumentoCabecalhoConfig {
  id              String                 @id @default(uuid())
  empresaId       String
  tipo            TipoDocumentoCabecalho
  nomeEmpresa     String?
  cnpj            String?
  endereco        String?
  cidade          String?
  estado          String?
  cep             String?
  telefone        String?
  email           String?
  logoUrl         String?                @db.Text
  usarLogoGlobal  Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  empresa         Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo])
  @@index([empresaId])
}

model Cliente {
  id                String             @id @default(uuid())
  empresaId         String
  codigo            String
  tipoCliente       TipoCliente        @default(CNPJ)
  nome              String
  nomeFantasia      String?
  cpf               String?
  cnpj              String?
  inscricaoEstadual String?
  contatoNome       String?
  telefone          String?
  email             String?
  enderecoLinha1    String?
  enderecoNumero    String?
  enderecoLinha2    String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  observacao        String?
  status            StatusCadastro     @default(ATIVO)
  cadastroCompleto  Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  obras             Obra[]
  fichas            Ficha[]
  lancamentos       LancamentoDiario[]
  precos            PrecoClienteObra[]
  medicoes          Medicao[]
  orcamentos        Orcamento[]
  execucoes         Execucao[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, cpf])
  @@unique([empresaId, cnpj])
  @@index([empresaId])
  @@index([nome])
  @@index([status, nome])
}

model Obra {
  id                     String              @id @default(uuid())
  empresaId              String
  codigo                 String
  clienteId              String
  nome                   String
  contratoNumero         String?
  localidade             String?
  cidade                 String?
  uf                     String?
  dataInicio             DateTime?
  dataFim                DateTime?
  observacao             String?
  status                 StatusCadastro      @default(ATIVO)
  liberadaParaLancamento Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  empresa                Empresa             @relation(fields: [empresaId], references: [id])
  cliente                Cliente             @relation(fields: [clienteId], references: [id])
  fichas                 Ficha[]
  lancamentos            LancamentoDiario[]
  precos                 PrecoClienteObra[]
  medicoes               Medicao[]
  programacoes           AgendaProgramacao[]
  orcamentos             Orcamento[]
  execucoes              Execucao[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([nome])
  @@index([clienteId, status])
}

model Fornecedor {
  id                String         @id @default(uuid())
  empresaId         String
  codigo            String
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  telefone          String?
  email             String?
  enderecoLinha1    String?
  enderecoNumero    String?
  enderecoLinha2    String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  observacao        String?
  status            StatusCadastro @default(ATIVO)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  empresa           Empresa        @relation(fields: [empresaId], references: [id])
  ordensCompra      OrdemCompra[]
  orcamentoItensPreferenciais OrcamentoItem[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, cnpj])
  @@index([empresaId])
  @@index([razaoSocial])
  @@index([nomeFantasia])
  @@index([status, razaoSocial])
}

model CentroCustoCompra {
  id           String         @id @default(uuid())
  empresaId    String
  codigo       String
  nome         String
  descricao    String?
  status       StatusCadastro @default(ATIVO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  empresa      Empresa        @relation(fields: [empresaId], references: [id])
  ordensCompra OrdemCompra[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([nome])
  @@index([status, nome])
}

model CatalogoCompra {
  id               String             @id @default(uuid())
  empresaId        String
  codigo           String
  tipo             TipoCatalogoCompra
  descricao        String
  unidadePadrao    String
  valorPadrao      Decimal            @default(0) @db.Decimal(12, 2)
  observacao       String?
  status           StatusCadastro     @default(ATIVO)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  itensOrdemCompra OrdemCompraItem[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([tipo, status, descricao])
  @@index([descricao])
}

model PlanoConta {
  id            String         @id @default(uuid())
  empresaId     String
  classificacao String
  nome          String
  tipo          TipoPlanoConta
  categoria     String?
  descricao     String?
  status        StatusCadastro @default(ATIVO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  ordensCompra  OrdemCompra[]

  @@unique([empresaId, classificacao])
  @@index([empresaId])
  @@index([tipo, status, nome])
  @@index([status, nome])
  @@index([classificacao])
}

model Equipamento {
  id                           String                       @id @default(uuid())
  empresaId                    String
  naturezaRecurso              NaturezaRecursoEquipamento  @default(PROPRIO)
  tipoRecurso                  TipoRecurso
  tipoControle                 TipoControleEquipamento      @default(HORIMETRO)
  descricao                    String
  descricaoOperacional         String?
  placaOuTag                   String
  classeOperacional            String?
  complementar                 Boolean                      @default(false)
  fabricante                   String?
  modelo                       String?
  marcaModelo                  String?
  anoFabricacao                Int?
  dataEntrada                  DateTime?
  capacidadeM3                 Decimal?                     @db.Decimal(10, 2)
  unidadeCapacidade            String?
  unidadeEconomicaPadrao       UnidadeEconomicaCusto?
  custoPadrao                   Decimal?                     @db.Decimal(14, 4)
  permitirEdicaoOrcamento      Boolean                      @default(true)
  caracteristicasTecnicas      Json?
  apelido                      String?
  observacao                   String?
  status                       StatusCadastro               @default(ATIVO)
  statusOperacional            StatusEquipamentoOperacional @default(ATIVO)
  horimetroAtual               Decimal?                     @db.Decimal(12, 2)
  kmAtual                      Decimal?                     @db.Decimal(12, 1)
  periodicidadeManutencaoHoras Int?
  periodicidadeManutencaoKm    Int?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  empresa                      Empresa                      @relation(fields: [empresaId], references: [id])
  lancamentos                  LancamentoDiario[]
  precos                       PrecoClienteObra[]
  leituras                     LeituraEquipamento[]
  planosManutencao             PlanoManutencao[]
  agendasManutencao            AgendaManutencao[]
  programacoes                 AgendaProgramacao[]
  manutencoesExecutadas        ManutencaoExecutada[]
  alertasManutencao            AlertaManutencao[]
  ordensCompraCentroCusto      OrdemCompra[]                @relation("OrdemCompraCentroCustoEquipamento")
  orcamentoItens               OrcamentoItem[]
  recursosRealizados           RecursoRealizado[]            @relation("RecursoRealizadoRecurso")
  recursosBoletimDiario        RecursoBoletimDiario[]        @relation("RecursoBoletimDiarioRecurso")

  @@unique([empresaId, placaOuTag])
  @@index([empresaId])
  @@index([naturezaRecurso, status])
  @@index([descricao])
  @@index([tipoRecurso, status])
  @@index([classeOperacional])
  @@index([statusOperacional, status])
  @@index([complementar, status, tipoRecurso])
}

model OrdemCompra {
  id                       String                     @id @default(uuid())
  empresaId                String
  numeroOrdem              String
  dataEmissao              DateTime                   @default(now())
  status                   StatusOrdemCompra          @default(ABERTA)
  tipoCompra               TipoCatalogoCompra         @default(PRODUTO)
  fornecedorId             String
  centroCustoId            String?
  planoContaId             String?
  centroCustoTipo          TipoCentroCustoOrdemCompra @default(SETOR)
  centroCustoNome          String
  centroCustoEquipamentoId String?
  formaPagamento           String?
  numeroParcelas           Int                        @default(1)
  primeiroVencimento       DateTime?
  numeroNotaFiscal         String?
  solicitanteNome          String?
  observacaoFinanceira     String?
  observacao               String?
  motivoExclusao           String?
  excluidaEm               DateTime?
  excluidaPorNome          String?
  valorTotal               Decimal                    @db.Decimal(14, 2)
  criadoPorId              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
